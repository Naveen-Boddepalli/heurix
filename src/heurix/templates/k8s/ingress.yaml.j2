# Synthesized deterministically by Heurix (hx)
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ ingress_name | yaml_scalar }}
{% if namespace %}
  namespace: {{ namespace | yaml_scalar }}
{% endif %}
spec:
  ingressClassName: {{ ingress_class_name | yaml_scalar }}
  rules:
{% for rule in rules %}
    - http:
        paths:
{% for path_entry in rule.http.paths %}
          - path: {{ path_entry.path | yaml_scalar }}
            pathType: {{ path_entry.pathType | yaml_scalar }}
            backend:
              service:
                name: {{ path_entry.backend.service.name | yaml_scalar }}
                port:
                  number: {{ path_entry.backend.service.port.number }}
{% endfor %}
{% endfor %}
