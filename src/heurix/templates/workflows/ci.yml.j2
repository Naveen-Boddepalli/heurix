{% for matrix_val in matrix_vals %}
          - {{ matrix_val | yaml_scalar }}
{% endfor %}
{% endfor %}
{% endif %}
{% if job_services %}
    services:
{% for svc_name, svc in job_services.items() %}
      {{ svc_name | yaml_scalar }}:
        image: {{ svc.get('image') | yaml_scalar }}
{% if svc.get('env') %}
        env:
{{ svc.get('env') | yaml_block(indent=10) }}
{% endif %}
{% if svc.get('ports') %}
        ports:
{% for port_map in svc.get('ports', []) %}
          - {{ port_map | yaml_scalar }}
{% endfor %}
{% endif %}
{% if svc.get('options') %}
        options: {{ svc.get('options') | yaml_scalar }}
{% endif %}
{% endfor %}
{% endif %}
